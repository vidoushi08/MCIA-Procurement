DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost:3306/mcia_procurement
# URL-encode special characters in PASSWORD (for example # becomes %23, ! becomes %21)
GEMINI_API_KEY=your_gemini_api_key_here
APP_SECRET_KEY=replace_with_a_long_random_string
# Optional: SLA background checks (default enabled, every 60 minutes)
SLA_CHECK_ENABLED=true
SLA_CHECK_INTERVAL_MINUTES=60
# Optional: email notifications (leave blank to log instead of sending)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
